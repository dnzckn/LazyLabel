# Modernization workspace (main-web): legacy/ is a local frozen worktree of main, never committed;
# re-include the two file types the global *.json / *.txt rules would otherwise swallow in the analysis and modernized trees.
/legacy/
!/analysis/**/*.json
!/analysis/**/*.txt
!/modernized/**/*.json
!/modernized/**/*.txt
# And the third, found 2026-09-23: the global *.npz rule swallowed the 24 NPZ goldens legacy wrote, so
# the byte-for-byte NPZ proof, and 17 API tests that read them, passed on one machine and nowhere else.
# Only the goldens: the .differential/ outputs beside them are regenerated by every run.
!/modernized/lazylabel/core/exporters/goldens/**/*.npz
# And legacy's propagation, captured on the synthetic clip: the masks behind Phase 6's exit criterion 2.
!/modernized/lazylabel-reimagined/inference/tests/goldens/**/*.npz
# And the acceptance corpus legacy wrote, with legacy's own re-saves: Phase 6's exit criterion 4.
!/modernized/lazylabel-reimagined/api/test/fixtures/acceptance-corpus/**/*.npz
!/modernized/lazylabel-reimagined/api/test/fixtures/acceptance-oracle/**/*.npz
node_modules/
coverage/
*.onnx
__pycache__/
