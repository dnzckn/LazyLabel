{
  "name": "lazylabel-web",
  "version": "0.1.0",
  "private": true,
  "description": "LazyLabel web: one install and one build for every JavaScript package, in dependency order.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "lazylabel/core/exporters",
    "lazylabel-reimagined/settings-schema",
    "lazylabel-reimagined/contracts",
    "lazylabel-reimagined/api",
    "lazylabel-reimagined/web"
  ],
  "scripts": {
    "prepare": "npm run build --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "node lazylabel-reimagined/api/dist/src/cli.js",
    "dev": "npm run dev -w lazylabel-reimagined/web",
    "ai:setup": "node scripts/ai-setup.mjs",
    "ai:models": "node scripts/ai-models.mjs"
  }
}
