{
  "name": "@lazylabel/annotation-formats",
  "version": "0.1.0",
  "private": true,
  "description": "Reader and writer for LazyLabel's seven annotation formats, ported from legacy/lazylabel and proven equivalent against golden files.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --exclude test/differential/**",
    "test:watch": "vitest",
    "test:differential": "vitest run test/differential",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ]
}
