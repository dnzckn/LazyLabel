{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  // `tools` ships with the build so `npm run acceptance` runs compiled JS. Node's
  // type stripping does not rewrite a relative `.js` import to the `.ts` beside it,
  // and every import in this package is written `.js` as ESM requires.
  "include": ["src", "tools"]
}
