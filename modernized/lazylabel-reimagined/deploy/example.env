# Copy to `.env` beside this file, then: docker compose --env-file .env up --build
#
# Two variables are required and neither has a default, on purpose. A dataset root the app guessed
# at would silently answer every listing with "empty", which reads as "you have no images" rather
# than "you pointed me somewhere else".

# The folder holding your images. Annotation sidecars are written BESIDE them, in place, because
# decision 5 makes those files the source of truth — so this is the folder you already back up.
DATASET_ROOT=/absolute/path/to/your/images

# ---------------------------------------------------------------------------------------------
# Everything below is for the AI tools, which are opt-in:
#
#     docker compose --env-file .env --profile ai up --build
#
# Without them the app runs and everything except SAM prompts and propagation works.
# ---------------------------------------------------------------------------------------------

# The folder holding the model checkpoints, mounted READ-ONLY. `analysis/lazylabel/MODEL_MANIFEST.md`
# lists which files and their verified SHA-256s; nothing downloads one at runtime (SEC-03).
MODEL_DIR=/absolute/path/to/your/checkpoints

# Tells the API where the inference service is. Left EMPTY by default, which means "there is none"
# — a supported deployment rather than a broken one. Set it only with the `ai` profile, or the API
# will spend every health check failing to reach a service that is not running.
#
# `inference` is the compose service name, resolved on the compose network.
LAZYLABEL_INFERENCE_URL=
# LAZYLABEL_INFERENCE_URL=http://inference:8788
